# Appfile
# Details: https://docs.fastlane.tools/advanced/#appfile

app_identifier(ENV['APP_IDENTIFIER'] || "io.ionic.starter")

# Apple Developer account email (optional, can be passed via env APPLE_ID)
apple_id(ENV['APPLE_ID']) if ENV['APPLE_ID']

# Team ID from Developer Portal (optional, can be passed via env FASTLANE_TEAM_ID)
team_id(ENV['FASTLANE_TEAM_ID']) if ENV['FASTLANE_TEAM_ID']

# App Store Connect Team ID (optional, can be passed via env FASTLANE_ITC_TEAM_ID)
itc_team_id(ENV['FASTLANE_ITC_TEAM_ID']) if ENV['FASTLANE_ITC_TEAM_ID']
