# Fastfile for dev-blog-client iOS
opt_out_usage

default_platform(:ios)

platform :ios do
  before_all do
    ENV["LANG"] = "en_US.UTF-8"
    ENV["LC_ALL"] = "en_US.UTF-8"
  end

  project_root = File.expand_path("../../..", __dir__)
  release_dir = File.expand_path("../../../release/ios", __dir__)

  desc "Build Angular app and sync web assets to Capacitor iOS"
  lane :sync_cap do
    UI.header("Step: Syncing Angular Web Build to Capacitor iOS")
    Dir.chdir(project_root) do
      sh("npm run build")
      sh("npx cap sync ios")
    end
  end

  desc "Install CocoaPods dependencies"
  lane :install_pods do
    UI.header("Step: Installing CocoaPods dependencies")
    cocoapods(
      clean_install: false,
      podfile: "./Podfile"
    )
  end

  desc "Build Ad-Hoc IPA (for Diawi, Firebase App Distribution, registered devices)"
  lane :build_adhoc do |options|
    skip_sync = options[:skip_sync] || false
    sync_cap unless skip_sync

    FileUtils.mkdir_p(release_dir)
    ipa_dest = File.join(release_dir, "dev-blog-client-adhoc.ipa")

    UI.header("Step: Building Ad-Hoc IPA")

    # Check if a valid codesigning identity exists in Keychain
    identities_check = `security find-identity -p codesigning -v 2>&1`
    has_valid_identity = !identities_check.include?("0 valid identities found")

    if has_valid_identity
      UI.message("✅ Found valid Apple code signing identity in Keychain. Building signed IPA...")
      build_app(
        workspace: "App.xcworkspace",
        scheme: "App",
        clean: true,
        configuration: "Release",
        export_method: "ad-hoc",
        output_directory: release_dir,
        output_name: "dev-blog-client-adhoc.ipa",
        export_xcargs: "-allowProvisioningUpdates",
        export_options: {
          compileBitcode: false
        }
      )
    else
      UI.important("⚠️ No valid Apple signing identity found in Keychain.")
      UI.message("Building unsigned/adhoc IPA package for CI & Distribution...")

      # Build without codesigning requirement
      sh("xcodebuild -workspace App.xcworkspace -scheme App -configuration Release -destination 'generic/platform=iOS' CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY='' PROVISIONING_PROFILE_SPECIFIER='' DEVELOPMENT_TEAM='' clean build -derivedDataPath build")

      app_path = File.expand_path("build/Build/Products/Release-iphoneos/App.app", __dir__)
      UI.message("Packaging App.app from #{app_path} into IPA...")

      payload_dir = File.expand_path("Payload", __dir__)
      FileUtils.rm_rf(payload_dir)
      FileUtils.mkdir_p(payload_dir)
      FileUtils.cp_r(app_path, payload_dir)

      Dir.chdir(__dir__) do
        sh("zip -qr '#{ipa_dest}' Payload")
      end
      FileUtils.rm_rf(payload_dir)
    end

    UI.success("🎉 Ad-Hoc IPA generated successfully at #{ipa_dest}")
  end

  desc "Build Development IPA"
  lane :build_dev do |options|
    build_adhoc(options)
  end

  desc "Build App Store IPA"
  lane :build_appstore do |options|
    skip_sync = options[:skip_sync] || false
    sync_cap unless skip_sync

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      clean: true,
      configuration: "Release",
      export_method: "app-store",
      output_directory: release_dir,
      output_name: "dev-blog-client-appstore.ipa",
      export_xcargs: "-allowProvisioningUpdates",
      export_options: {
        compileBitcode: false,
        uploadBitcode: false
      }
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    build_appstore(skip_sync: false)
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Build Ad-Hoc IPA and upload to Firebase App Distribution"
  lane :firebase do |options|
    build_adhoc(options)

    firebase_app_id = options[:app_id] || ENV["FIREBASE_IOS_APP_ID"]
    firebase_token = options[:token] || ENV["FIREBASE_TOKEN"]
    groups = options[:groups] || ENV["FIREBASE_GROUPS"] || "dev-team"
    notes = options[:notes] || ENV["RELEASE_NOTES"] || "iOS Build (#{Time.now.strftime('%Y-%m-%d %H:%M')})"
    ipa_file = File.join(release_dir, "dev-blog-client-adhoc.ipa")

    if firebase_app_id.to_s.empty?
      UI.important("⚠️ Missing FIREBASE_IOS_APP_ID. Set ENV['FIREBASE_IOS_APP_ID'] to upload to Firebase.")
      next
    end

    UI.header("Step: Uploading IPA to Firebase App Distribution")
    token_arg = firebase_token && !firebase_token.empty? ? "--token \"#{firebase_token}\"" : ""
    sh("npx -y firebase-tools appdistribution:distribute \"#{ipa_file}\" --app \"#{firebase_app_id}\" --groups \"#{groups}\" --release-notes \"#{notes}\" #{token_arg}")
    UI.success("🚀 IPA successfully distributed to Firebase App Distribution!")
  end
end
